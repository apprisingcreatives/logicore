# ============================================================
# Logicore — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_PORT=4000
APP_NAME=Logicore
APP_URL=http://localhost:3000

# ── Database (PostgreSQL + pgvector + TimescaleDB) ───────────
DATABASE_URL=postgresql://logicore:logicore_dev_2024@localhost:5432/logicore_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ── AI / LLM ────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Cloud Storage ────────────────────────────────────────────
STORAGE_BUCKET=logicore-documents
STORAGE_REGION=asia-southeast1

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@logicore.ph

# ── SMS (Semaphore — Philippine SMS provider) ────────────────
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=LOGICORE

# ── Maps ─────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Frontend (Public) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_MAPBOX_TOKEN=
