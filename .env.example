# Supabase Database & Environment Variables for Logicore

# Supabase PostgreSQL Connection String (Transaction Mode / Direct Pool)
DATABASE_URL=postgres://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# NestJS Backend API
PORT=4000
JWT_SECRET=supersecret_logicore_jwt_key_2026
GEMINI_API_KEY=[YOUR-GEMINI-API-KEY]
